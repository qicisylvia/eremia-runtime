--- a/src/logging.ts
+++ b/src/logging.ts
@@ -47,7 +47,23 @@ function safeContext(
 
 export function safeErrorMessage(error: unknown, secrets: readonly string[] = []): string {
   if (error instanceof Error) {
-    return redactText(error.message, secrets);
+    const messages = [error.message];
+    const seen = new Set<unknown>([error]);
+    let cause: unknown = error.cause;
+
+    // Undici exposes useful transport details (for example Body Timeout Error)
+    // through Error.cause. Preserve a short, redacted cause chain so a genuine
+    // disconnect can be distinguished from a client-side timeout.
+    while (cause !== undefined && cause !== null && !seen.has(cause) && messages.length < 4) {
+      seen.add(cause);
+      const causeMessage = cause instanceof Error ? cause.message : String(cause);
+      if (causeMessage && causeMessage !== messages[messages.length - 1]) {
+        messages.push(`cause: ${causeMessage}`);
+      }
+      cause = cause instanceof Error ? cause.cause : undefined;
+    }
+
+    return redactText(messages.join("; "), secrets);
   }
   return redactText(String(error), secrets);
 }
