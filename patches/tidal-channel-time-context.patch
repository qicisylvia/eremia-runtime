 const INBOUND_STALE_MS = 45000
 
+function messageTimeContext(value: unknown): string {
+  const candidate = typeof value === 'string' ? new Date(value) : new Date()
+  const occurredAt = Number.isNaN(candidate.getTime()) ? new Date() : candidate
+  let formatted: string
+  try {
+    formatted = new Intl.DateTimeFormat('zh-CN-u-nu-latn', {
+      timeZone: TIME_ZONE,
+      year: 'numeric', month: '2-digit', day: '2-digit', weekday: 'long',
+      hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23',
+    }).format(occurredAt)
+  } catch {
+    formatted = occurredAt.toISOString()
+  }
+  return `[时间上下文｜${TIME_ZONE}] ${formatted}。这是消息发生时间；请按它判断“今天/昨天/明天”和是否已跨过午夜。`
+}
