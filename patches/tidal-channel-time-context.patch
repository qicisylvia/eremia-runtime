@@ -51,7 +51,50 @@ const AI_NAME = process.env.RELAY_AI_NAME ?? 'AI'
 const HUMAN_NAME = process.env.RELAY_HUMAN_NAME ?? '对方'
+const TIME_ZONE = process.env.RELAY_TIMEZONE ?? 'Asia/Shanghai'
+const TIME_CONTEXT_INTERVAL_MS = 30 * 60 * 1000
 const CHAT_ID = 'me' // single-user channel; constant id echoed back on reply
 const INBOUND_STALE_MS = 45000
 
+let lastTimeContextAt: number | undefined
+let lastTimeContextDay: string | undefined
+
+function localDateKey(occurredAt: Date): string {
+  try {
+    return new Intl.DateTimeFormat('en-CA', {
+      timeZone: TIME_ZONE,
+      year: 'numeric', month: '2-digit', day: '2-digit',
+    }).format(occurredAt)
+  } catch {
+    return occurredAt.toISOString().slice(0, 10)
+  }
+}
+
+function shouldAddTimeContext(occurredAt: Date): boolean {
+  const timestamp = occurredAt.getTime()
+  const localDay = localDateKey(occurredAt)
+  if (lastTimeContextAt !== undefined
+    && lastTimeContextDay === localDay
+    && timestamp - lastTimeContextAt < TIME_CONTEXT_INTERVAL_MS) {
+    return false
+  }
+  lastTimeContextAt = timestamp
+  lastTimeContextDay = localDay
+  return true
+}
+
+function messageTimeContext(occurredAt: Date): string {
+  let formatted: string
+  try {
+    formatted = new Intl.DateTimeFormat('zh-CN-u-nu-latn', {
+      timeZone: TIME_ZONE,
+      year: 'numeric', month: '2-digit', day: '2-digit', weekday: 'long',
+      hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23',
+    }).format(occurredAt)
+  } catch {
+    formatted = occurredAt.toISOString()
+  }
+  return `[时间] ${formatted}`
+}
+
