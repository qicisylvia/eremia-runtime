# ============================================================
# eremia-runtime 服务的环境变量（Zeabur 上逐条填）
# ============================================================

# ===== 必填 =====
# 本地电脑运行 `claude setup-token` 生成（需要 Pro/Max 订阅）
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxx

# Eremia 的默认模型
ANTHROPIC_MODEL=claude-opus-4-6

# ===== MCP（内网地址，服务名/端口按你 Zeabur 面板的实际填）=====
NEST_MCP_URL=http://shared-nest.zeabur.internal:8080/mcp
NEST_MCP_TOKEN=replace-with-your-MCP_STATIC_TOKEN
BRAIN_MCP_URL=http://ombre-brain.zeabur.internal:8000/mcp
BRAIN_EXTRA_MCP_URL=http://ombre-brain.zeabur.internal:8000/mcp-extra
# 论坛 MCP（Eremia 打牌用；地址/token 按论坛给的教程填）
# GARDEN_MCP_URL=
# GARDEN_MCP_TOKEN=

# ===== Tidal Echo 聊天通道（指向 tidal-relay 服务的内网地址）=====
RELAY_URL=http://tidal-relay.zeabur.internal:8080/relay
# 与 tidal-relay 服务的 RELAY_SECRET 必须一致（生成: python -c "import secrets; print(secrets.token_urlsafe(32))"）
RELAY_SECRET=change-me-same-as-relay
RELAY_AI_NAME=Eremia
RELAY_HUMAN_NAME=瓷瓷

# ===== 时间感知与自主唤醒（默认开）=====
# 轮询历史不调用模型；到点后每段离开最多 1 次 check-in，夜间整理每天最多 1 次。
TIMEKEEPER_ENABLED=true
TIMEKEEPER_TIMEZONE=Asia/Shanghai
TIMEKEEPER_HUMAN_NAME=瓷瓷
# 最后一条真实聊天满 4 小时后醒来一次；你没有回来前不会重复，凌晨到点则顺延到 09:00 后。
# TIMEKEEPER_CHECKIN_ENABLED=true
# TIMEKEEPER_CHECKIN_IDLE_HOURS=4
# TIMEKEEPER_CHECKIN_START_HOUR=9
# TIMEKEEPER_CHECKIN_END_HOUR=24
# 夜间 03:30~06:00 之间、确认至少 90 分钟没聊天后，最多唤醒一次做一件自主小事。
# TIMEKEEPER_NIGHT_ENABLED=true
# TIMEKEEPER_NIGHT_AT=03:30
# TIMEKEEPER_NIGHT_WINDOW_MINUTES=150
# TIMEKEEPER_NIGHT_MIN_IDLE_MINUTES=90
# TIMEKEEPER_POLL_SECONDS=300

# ===== prism 仪表盘（可选，默认开；不想要就设 false）=====
PRISM_ENABLED=true
# prism 登录密码 = 容器内命令执行权限，务必长随机
DASHBOARD_PASSWORD=change-me-to-a-long-random-password
PORT=8001

# ===== 论坛唤醒桥（可选，默认关；部署稳了再开）=====
WAKE_BRIDGE_ENABLED=false
# GARDEN_BASE_URL=https://wake-v1.abysslumina.com
# GARDEN_MACHINE_TOKEN=
# 同一狼人杀行动轮：立即唤醒 1 次，30 秒后最多再提醒 1 次，120 秒后视为新一轮
# WAKE_GAME_TURN_WINDOW_SECONDS=120
# WAKE_GAME_TURN_REMINDER_DELAY_SECONDS=30
# WAKE_GAME_TURN_MAX_DELIVERIES=2

# ============================================================
# tidal-relay 服务的环境变量（另一个服务，单独填）
# ============================================================
# RELAY_SECRET=            与上面完全一致
# RELAY_DB=/data/relay.db  必填！不设的话数据库落在容器临时盘，每次重部署聊天记录清零
# RELAY_AI_NAME=Eremia
# RELAY_HUMAN_NAME=瓷瓷
# RELAY_ALLOW_ORIGINS=https://你的relay公网域名
# RELAY_APP_MODULE=app:app     上游 ASGI 模块名不同时才需要改
# 可选 Web Push（锁屏推送）：按上游文档 vapid --gen 生成后填
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_PEM=/data/private_key.pem
# VAPID_SUBJECT=mailto:qicisylvia@gmail.com
