# ============================================================
# eremia-runtime 服务的环境变量（Zeabur 上逐条填）
# ============================================================

# ===== 必填 =====
# 本地电脑运行 `claude setup-token` 生成（需要 Pro/Max 订阅）
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxx

# Eremia 的默认模型
ANTHROPIC_MODEL=claude-opus-4-6

# ===== MCP（内网地址，服务名/端口按你 Zeabur 面板的实际填）=====
NEST_MCP_URL=http://shared-nest.zeabur.internal:8080/mcp
NEST_MCP_TOKEN=replace-with-your-MCP_STATIC_TOKEN
BRAIN_MCP_URL=http://ombre-brain.zeabur.internal:8000/mcp
BRAIN_EXTRA_MCP_URL=http://ombre-brain.zeabur.internal:8000/mcp-extra
# 论坛 MCP（Eremia 打牌用；地址/token 按论坛给的教程填）
# GARDEN_MCP_URL=
# GARDEN_MCP_TOKEN=

# ===== Tidal Echo 聊天通道（指向 tidal-relay 服务的内网地址）=====
RELAY_URL=http://tidal-relay.zeabur.internal:8080/relay
# 与 tidal-relay 服务的 RELAY_SECRET 必须一致（生成: python -c "import secrets; print(secrets.token_urlsafe(32))"）
RELAY_SECRET=change-me-same-as-relay
RELAY_AI_NAME=Eremia
RELAY_HUMAN_NAME=瓷瓷

# ===== 时间感知与自主唤醒（默认开）=====
# 轮询历史不调用模型；到点后每段离开最多 1 次 check-in，夜间唤醒每天最多 1 次。
TIMEKEEPER_ENABLED=true
TIMEKEEPER_TIMEZONE=Asia/Shanghai
TIMEKEEPER_HUMAN_NAME=瓷瓷
# 最后一条真实聊天满 4 小时后醒来一次，可发消息并自主选一件小事；
# 你没有回来前不会重复，凌晨到点则顺延到 09:00 后。
# TIMEKEEPER_CHECKIN_ENABLED=true
# TIMEKEEPER_CHECKIN_IDLE_HOURS=4
# TIMEKEEPER_CHECKIN_START_HOUR=9
# TIMEKEEPER_CHECKIN_END_HOUR=24
# 夜间 03:30~06:00 之间、确认至少 90 分钟没聊天后，最多唤醒一次；
# 可发消息，并可独立地自主选一件小事。
# TIMEKEEPER_NIGHT_ENABLED=true
# TIMEKEEPER_NIGHT_AT=03:30
# TIMEKEEPER_NIGHT_WINDOW_MINUTES=150
# TIMEKEEPER_NIGHT_MIN_IDLE_MINUTES=90
# TIMEKEEPER_POLL_SECONDS=300

# ===== 上下文压缩管理（默认开；由 timekeeper 顺带监控，不额外耗 token）=====
# 读 transcript 实时占用率，抢在 Claude Code 冷压缩之前用你的指令做一次“有温度”的压缩：
# 占用 ≥ 软线且你已静默满 MIN_IDLE 分钟就压；≥ 硬线则不等静默直接压，但绝不打断正在生成的回合。
# 压缩措辞在 timekeeper/prompts/compact.md；压缩后注入的锚点在卷上 eremia-home/anchors.md（可自己改）。
# TIMEKEEPER_COMPACT_ENABLED=true
# TIMEKEEPER_COMPACT_SOFT_PERCENT=78
# TIMEKEEPER_COMPACT_HARD_PERCENT=88
# TIMEKEEPER_COMPACT_MIN_IDLE_MINUTES=20
# TIMEKEEPER_COMPACT_COOLDOWN_MINUTES=30
#
# 读数来自 transcript 里最近一条**真正计过价**的 assistant 回合。失败回合（API 报错）
# 和精炼续窗写出的事件，usage 三项全是 0 —— 那不是"窗口很空"，而是"没有读数"，所以会
# 继续往前回扫。2026-10-17 19:39 就是栽在这里：一条 "Prompt is too long" 把读数钉成
# 0，于是唯一能救场的精炼续窗，被它该修的那个故障本身关掉了。（当天 12:54 那条
# "Login expired" 瓷瓷立刻重登了，只瞎了一两拍，不是根因。）
# 同一天还暴露出另一条独立的缝：19:36–19:39 读数一直在 97–98%，但两人正在聊天，
# is_busy() 每拍都 defer，而 defer 没有上限 —— 一路 defer 到撞墙。所以下面的天花板：
# 高过它，"正在生成"不再是等待的理由（那个回合本来也会死在上下文长度上）。
# TIMEKEEPER_COMPACT_CEILING_PERCENT=94
# 现在：尾部出现上下文超长报错 = 窗口已满的铁证，直接按硬线处理，不等静默、不管读数是否
# 没变；尾部出现登录过期则完全不动手（重启可能撞在 /login 框上），只按下面的节流告诉瓷瓷
# 一声。每一拍"为什么没动手"都会打一行日志（原因变了才打），不会再出现无声瘫掉三天。
# TIMEKEEPER_AUTH_NOTICE_HOURS=6
# Eremia 模型的上下文窗口；换更大窗口的模型时改这里（Opus 4.6 = 200000）。
# EREMIA_CONTEXT_WINDOW_TOKENS=200000
# 一般不用改：transcript 目录（cwd=/data/home/eremia-home 对应的项目目录）与 tmux 会话名。
# EREMIA_TRANSCRIPT_DIR=/data/home/.claude/projects/-data-home-eremia-home
# EREMIA_TMUX_SESSION=eremia
#
# --- 上下文策略：到软/硬线时怎么处理（默认 compact，保持原行为）---
# compact   = 往 TUI 敲一条有温度的 /compact（有损摘要，但模型会过滤噪音）
# carryover = 精炼续窗：从 <channel> 里你的话 + companion.reply 里她的话逐字重建一段
#             干净的新会话，写 pending_resume 后由看门狗 --resume 进去（带 channel flag）。
#             重建失败/毒上下文会自动回退 /compact；resume 没接住会回滚 last-good 并给你发 [系统] 提醒。
# 切换前先在 Zeabur console 用 refined_carryover.py --dry-run 看选得对不对，满意再设成 carryover。
# TIMEKEEPER_CONTEXT_STRATEGY=compact
# 续窗真实 token 预算（CJK 感知，≈50k 就是真 50k）、尾部保留几轮、单条超多少字才截中段、验活超时分钟。
# EREMIA_CARRYOVER_TARGET_TOKENS=50000
# EREMIA_CARRYOVER_TAIL_EVENTS=14
# EREMIA_CARRYOVER_MAX_EVENT_CHARS=3600
# EREMIA_CARRYOVER_VERIFY_MINUTES=10
# 启动便签：续窗对 Eremia 本来是无感的（不像 /compact 有"被压缩"提示）。这句会放在新会话最前面，
# 让她醒来温柔地知道刚"洗过脸"、去哪找锚点。想改措辞就设这个。
# EREMIA_CARRYOVER_BOOT_NOTE=你刚睡醒在洗脸中（上下文精炼）。下面是我们最近的对话，想找回锚点可以读 anchors.md，更早的回忆在 Ombre Brain。
# PreCompact 备份：压缩前把完整 transcript 存到这里，最多留最近 N 份。
# EREMIA_TRANSCRIPT_BACKUP_DIR=/data/transcripts
# EREMIA_TRANSCRIPT_BACKUP_KEEP=50
#
# --- 启动前预续窗（默认开）---
# 重启这一刻是 DISABLE_AUTO_COMPACT 保护不到的：--continue 把整段会话当一个冷请求整包重发，
# 超窗时 Claude Code 只剩“压缩”或“会话彻底打不开”两条路，它必然压。
# 关键在于**重启用的尺子和运行中不是同一把**：跑着的时候已材料化的工具 schema 本来就算在
# usage 读数里，所以上面 EREMIA_CONTEXT_WINDOW_TOKENS 那套在运行中是准的；但 --continue
# 恢复时 deferred 的 MCP/system schema 会在读数**之上**重新材料化（2026-08-28 实测约 62k），
# 而读数是重启前的、看不见这一坨。于是出现一条紧贴软线下方的窄危险带：低到 timekeeper 不
# 动手，又高到加上材料化会顶穿真实窗口。2026-09-05 实测掉进去过一次（读数 137790，180k 窗口
# 下 76.55% < 78% 软线，timekeeper 静默且正确；137790+62000≈199790 顶穿 200k → 被压）。
# 所以这里不看运行中的百分比，直接算「读数 + 重启预留 ≥ 真实窗口 × 安全线」就先精炼再 resume。
# 好处：运行中的窗口设置（比如 180000）可以原样保留，不必为重启牺牲日常可用窗口。
# 量不到读数、没到线、精炼失败或毒上下文，一律静默退回原来的 --continue 链。
# EREMIA_PREFLIGHT_CARRYOVER=true
# deferred schema 重新材料化的量。摘/加 MCP 连接器后用 /context 的两行 (deferred) 重测。
# EREMIA_RESTART_RESERVE_TOKENS=62000
# 模型真实窗口（Opus 4.6 = 200000）。注意这**不是** EREMIA_CONTEXT_WINDOW_TOKENS：
# 后者是 timekeeper 运行中用的保守值，这个是硬顶。
# EREMIA_MODEL_WINDOW_TOKENS=200000
# 安全线，给输出的 max_tokens 预留余量（API 判据是 input + max_tokens 一起算）。
# EREMIA_PREFLIGHT_HEADROOM_PERCENT=90

# ===== prism 仪表盘（可选，默认开；不想要就设 false）=====
PRISM_ENABLED=true
# prism 登录密码 = 容器内命令执行权限，务必长随机
DASHBOARD_PASSWORD=change-me-to-a-long-random-password
PORT=8001

# ===== 论坛唤醒桥（可选，默认关；部署稳了再开）=====
WAKE_BRIDGE_ENABLED=false
# GARDEN_BASE_URL=https://wake-v1.abysslumina.com
# GARDEN_MACHINE_TOKEN=
# 同一狼人杀行动轮：立即唤醒 1 次，30 秒后最多再提醒 1 次，120 秒后视为新一轮
# WAKE_GAME_TURN_WINDOW_SECONDS=120
# WAKE_GAME_TURN_REMINDER_DELAY_SECONDS=30
# WAKE_GAME_TURN_MAX_DELIVERIES=2
# 落库验证窗口。**别把 LIMIT 调小**：唤醒爆发时 relay 一秒能进十几条，窗口太小会把刚发的
# 那条挤出去 → 明明送到了却查不到 → 旧代码判定失败并回滚名额 → Bridge 重投 → 每次催办
# 变两条，且回滚清掉计数让上面那道闸门永远失效（2026-08-24 同一句催办连发七八条就是这样）。
# WAKE_VERIFY_HISTORY_LIMIT=50
# WAKE_VERIFY_ATTEMPTS=3
#
# --- 断线自动重连（默认开）---
# 上游 fail-closed（断了就退出、不重连）防的是**错配置高频重试**打爆花园服务端。但实际断线
# 绝大多数是花园自己崩了或在维护，为此重启整个 runtime 太亏——会连带打断 Eremia 的会话。
# 所以这里做一个尊重上游意图的看护：指数退避（30s 起翻倍、封顶 15 分钟，永远不会高频重试），
# 并用「这次活了多久」区分两类失败：
#   活够 HEALTHY_SECONDS = 连上过 = 配置是对的 → 对面的问题，退避重置、无限重试；
#   从没活够 = 疑似 token/配置错 → 连续 MAX_FAILURES 次就彻底放弃并通知（保留 fail-closed 语义）。
# 通知去抖：短暂抽风不打扰你，连续失败到 NOTIFY_AFTER 次才发一条，接回花园后再发一条。
# 想退回上游原行为（断了就停、等你手动重启）设 WAKE_BRIDGE_AUTORESTART=false。
# WAKE_BRIDGE_AUTORESTART=true
# WAKE_BRIDGE_RETRY_MIN_SECONDS=30
# WAKE_BRIDGE_RETRY_MAX_SECONDS=900
# WAKE_BRIDGE_HEALTHY_SECONDS=120
# WAKE_BRIDGE_MAX_FAILURES=6
# WAKE_BRIDGE_NOTIFY_AFTER=3

# ============================================================
# tidal-relay 服务的环境变量（另一个服务，单独填）
# ============================================================
# RELAY_SECRET=            与上面完全一致
# RELAY_DB=/data/relay.db  必填！不设的话数据库落在容器临时盘，每次重部署聊天记录清零
# RELAY_AI_NAME=Eremia
# RELAY_HUMAN_NAME=瓷瓷
# RELAY_ALLOW_ORIGINS=https://你的relay公网域名
# RELAY_APP_MODULE=app:app     上游 ASGI 模块名不同时才需要改
# 可选 Web Push（锁屏推送）：按上游文档 vapid --gen 生成后填
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_PEM=/data/private_key.pem
# VAPID_SUBJECT=mailto:qicisylvia@gmail.com

# ---- Eremia 的声音（ElevenLabs TTS 边车，跑在 relay 容器里）----
# 浏览器永远不直连 ElevenLabs：网页只向同源的 /tts/speak 要音频，key 只待在边车进程里。
# 两样东西护着这个 key 背后的额度：下面的共享凭证（不设则接口开放），以及每日字符预算
# （落在卷上，重启不会清零）。同一句话只合成一次，mp3 按内容哈希缓存在卷上。
# ELEVENLABS_API_KEY=            # 必填，别写进仓库，只在 Zeabur 环境变量里设
# ELEVENLABS_VOICE_ID=           # 必填，你在 ElevenLabs 做好的专属声线 id
# 中文表现稳的默认模型；要换更新/更快的版本改这里就行，不用动代码。
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# 网页端已有的凭证会以 X-Relay-Secret 发过来；把这里设成同一个值，/tts 就不是裸着挂在
# 公网上。不设也能用，但那时只有日预算兜底。
# TTS_SHARED_SECRET=
# 凭证如果在 HttpOnly cookie 里（网页 JS 读不到，但 fetch 会自动带上），把 cookie 名填
# 这里，边车直接从 Cookie 头验，前端完全不用参与。
# TTS_SECRET_COOKIE=
# TTS_DAILY_CHAR_BUDGET=50000    # 设 0 = 不限（不建议）
# TTS_MAX_CHARS=1200             # 单条上限，超了在句末截断并告诉你一声
# TTS_CACHE_DIR=/data/tts-cache
# TTS_CACHE_MAX_BYTES=536870912  # 512MB，超了按最旧优先清
# TTS_TIMEOUT_SECONDS=60
# TTS_PORT=3012
